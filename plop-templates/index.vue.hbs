<script setup lang="ts">
import { {{pascalCase name}}Api } from '@/api/{{domain}}'
import { useForm, useModal } from '@/components'
import { hasPermission } from '@/utils/common/hasPermission'
import {{pascalCase name}}Modal from './components/{{pascalCase name}}Modal.vue'
import { use{{pascalCase name}}Schema } from './schema'

const tableRef = ref<any>(null)
const [registerModal, { openModal }] = useModal()

const schemaMethods = {
  handleEdit(row: any) {
    openModal({ record: row })
  },
  handleDelete(row: any) {
    {{pascalCase name}}Api.delete(row.id)
      .then(() => {
        window.$message?.success?.('删除成功')
        reload()
      })
      .catch(() => {
        /* handled by interceptor */
      })
  },
}

const { columns, formSchemas } = use{{pascalCase name}}Schema(schemaMethods)

const [register, { getFieldsValue }] = useForm({
  gridProps: { cols: '1 s:1 m:2 l:3 xl:4' },
  schemas: formSchemas,
  submitOnReset: true,
  tableRef,
})

async function loadData(params: any) {
  return {{pascalCase name}}Api.list({ ...params, ...getFieldsValue() })
}

function reload() {
  tableRef.value?.reload()
}

function handleAdd() {
  openModal()
}
</script>

<template>
  <div class="system-page">
    <FormQuery @register="register" @submit="reload" />
    <BasicTable
      ref="tableRef"
      title="{{titleCase name}}"
      :columns="columns"
      :request="loadData"
      :row-key="(row: any) => row.id"
      :show-add-btn="hasPermission('{{domain}}:{{kebabCase name}}:create')"
      :scroll-x="670"
      @add="handleAdd"
    >
      <template #toolbar>
        <!-- 导出 / 导入等额外按钮放这里 -->
      </template>
    </BasicTable>
    <{{pascalCase name}}Modal @register="registerModal" @success="reload" />
  </div>
</template>
