<script setup lang="ts">
import { {{pascalCase name}}Api } from '@/api/{{domain}}'
import { FormEdit, useForm, useModalInner } from '@/components'
import { use{{pascalCase name}}Schema } from '../schema'

const emit = defineEmits<{
  success: []
  register: [instance: any, uuid: number]
}>()

const isEdit = ref(false)
const recordId = ref<number>()

// 需要按新增/编辑切换字段时，在 schema 的 editForm.ifShow 里用 methods.isCreate()
const { editFormSchemas } = use{{pascalCase name}}Schema({
  isCreate: () => !isEdit.value,
})

const [registerForm, { setFieldsValue, resetFields, validate, getFieldsValue }] = useForm({
  schemas: editFormSchemas,
  showActionButtonGroup: false, // 提交交给 BasicModal 底部按钮
})

const [registerModal, { closeModal, setModalProps }] = useModalInner(async (data: any) => {
  const record = data?.record
  isEdit.value = Boolean(record?.id)
  recordId.value = record?.id
  await resetFields() // 复用弹窗必须先清上一次的数据
  if (isEdit.value)
    await setFieldsValue(await {{pascalCase name}}Api.detail(recordId.value!))
})

async function handleOk() {
  try {
    await validate()
  }
  catch {
    return // 校验失败：保留弹窗
  }
  setModalProps({ confirmLoading: true })
  try {
    const values = getFieldsValue<Record<string, unknown>>()
    if (isEdit.value)
      await {{pascalCase name}}Api.update({ ...values, id: recordId.value! } as System.{{pascalCase name}}UpdatePayload)
    else
      await {{pascalCase name}}Api.create(values as System.{{pascalCase name}}CreatePayload)
    window.$message?.success?.('保存成功')
    closeModal()
    emit('success')
  }
  catch {
    /* handled by interceptor */
  }
  finally {
    setModalProps({ confirmLoading: false })
  }
}
</script>

<template>
  <BasicModal
    :title="isEdit ? '编辑' : '新增'"
    :mask-closable="false"
    draggable
    @register="registerModal"
    @ok="handleOk"
  >
    <FormEdit @register="registerForm" />
  </BasicModal>
</template>
